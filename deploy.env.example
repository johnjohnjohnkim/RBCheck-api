# Settings for the Docker stack (docker-compose.yml). Copy to deploy.env and fill in;
# deploy.env is gitignored (on a server also: chmod 600 deploy.env).
# Always pass it explicitly:  docker compose --env-file deploy.env up -d --build
# Do NOT use your dev .env here: it holds your real database password.

# Marks this as the deploy file; the stack refuses to start without it, so a forgotten
# --env-file cannot silently pick up the dev .env.
RBCHECK_DEPLOY_ENV=1

# A long random password for the new database inside the stack. Use only letters,
# digits, - and _ (token_urlsafe does): characters like $ and # are mangled by env files.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# It is applied when the database volume is first created; changing it later does not
# change the existing database.
DATABASE_PASSWORD=

# Two different tokens, 24+ characters each (same generator as above).
READ_TOKEN=
WRITE_TOKEN=

# The website origin(s) allowed to call the API from a browser (no wildcard, no trailing slash).
CORS_ORIGINS=https://gwanwoo.dev

# The API's public address. A domain name gets an automatic HTTPS certificate;
# leave as :80 for plain HTTP (local testing only).
SITE_ADDRESS=:80

# Optional
# TIMEZONE=America/Toronto
# HTTP_PORT=80      # local testing only; keep 80/443 with a real domain
# HTTPS_PORT=443
