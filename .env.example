# Copy this file to .env and fill in real values.
# Never commit the real .env — it is gitignored. Secure it: chmod 600 .env
# Keep comments on their own lines; some tools read a trailing "# ..." as
# part of the value.

# ── PostgreSQL connection ─────────────────────────────────────────────────────
# Under docker compose the host is the "db" service; locally, e.g. localhost.
DATABASE_HOSTNAME=db
DATABASE_PORT=5432
DATABASE_USERNAME=rbcheck
# Generate with: openssl rand -hex 24
DATABASE_PASSWORD=
DATABASE_NAME=rbcheck

# ── Ingest ────────────────────────────────────────────────────────────────────
# Shared with the Mac agent. Generate with: openssl rand -hex 32
INGEST_API_KEY=

# ── Time ──────────────────────────────────────────────────────────────────────
TIMEZONE=America/Toronto

# ── HTTPS (docker compose only) ───────────────────────────────────────────────
# Caddy gets certificates for these names.
API_DOMAIN=api.rbcheck.gwanwoo.dev
# The public demo API, with scrambled data
DEMO_API_DOMAIN=api.rbcheckdemo.gwanwoo.dev
