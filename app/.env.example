# Copy to .env and fill in real values. Never commit the real .env (it is gitignored).
# There are two kinds of machine; each uses only its own section.

# ══ SERVER (the API; runs in AWS / Docker or locally) ═════════════════════════

# PostgreSQL
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_NAME=

# Bearer tokens, each at least 24 characters and different from each other.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
READ_TOKEN=
WRITE_TOKEN=

# Browser origins allowed to call the API (comma separated, no wildcards).
# For local development add http://127.0.0.1:3000
CORS_ORIGINS=https://gwanwoo.dev

# Optional
# TIMEZONE=America/Toronto
# ENABLE_DOCS=false
# IP_ADDRESS=            # overrides DATABASE_HOSTNAME as the Postgres host

# ══ MAC (the poller; needs NO database settings) ══════════════════════════════

# RBCHECK_API_URL=https://api.rbcheck.gwanwoo.dev
# RBCHECK_WRITE_TOKEN=   # the server's WRITE_TOKEN
# RBC_HANDLE_ID=72272
# RBC_CHATDB_PATH=       # default ~/Library/Messages/chat.db
# POLL_SECONDS=5
