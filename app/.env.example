# Copy this file to .env and fill in real values.
# Never commit the real .env — it is gitignored.
# Secure it: chmod 600 .env
#
# No secrets ship inside the repo. The recipient provides all values below.

# ── PostgreSQL connection ─────────────────────────────────────────────────────
DATABASE_HOSTNAME=    # Postgres host, e.g. localhost or 10.0.0.5
DATABASE_PORT=        # Postgres port, typically 5432
DATABASE_USERNAME=    # Postgres role/user
DATABASE_PASSWORD=    # Postgres password
DATABASE_NAME=        # Database name

# ── Auth ───────────────────────────────────────────────────────────────────────
SECRET_KEY=                       # Signing key for JWTs
ALGORITHM=                        # JWT signing algorithm, e.g. HS256
ACCESS_TOKEN_EXPIRE_MINUTES=      # JWT expiry, in minutes
